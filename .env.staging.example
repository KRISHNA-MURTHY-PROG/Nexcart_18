# ════════════════════════════════════════════════════════════════════════════
# STAGING ENVIRONMENT — separate deploy for testing before production
#
# This is a TEMPLATE for a second deployment (e.g. staging.yourapp.com or a
# Vercel "Preview"/separate-project deployment) that uses its OWN database and
# OWN Razorpay TEST keys, so you can safely test changes without touching real
# customer data or moving real money.
#
# Setup steps:
#   1. Create a second Supabase project (free tier) — use its connection
#      strings below instead of your production ones.
#   2. In Razorpay Dashboard, switch to "Test Mode" (toggle top-right) and
#      copy the Test API keys — these never move real money.
#   3. Create a second Firebase project OR reuse the same one with a separate
#      Firebase Auth user pool / test users (recommended: separate project to
#      avoid mixing test accounts with real users).
#   4. Deploy this as a separate Vercel project (e.g. "nexcart-staging"),
#      pointing at the same GitHub repo/branch, with these env vars set in
#      its own Vercel Project Settings → Environment Variables.
#   5. Set NEXT_PUBLIC_APP_URL below to the staging deployment's URL.
# ════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://nexcart-staging.vercel.app
NODE_ENV=production

# ── Database (SEPARATE Supabase project — do NOT point at production DB) ──────
DATABASE_URL=postgresql://postgres.[staging-project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[staging-project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Firebase (Client SDK) — ideally a separate Firebase project for staging ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Razorpay — MUST be TEST MODE keys (Dashboard → toggle "Test Mode") ────────
# Test keys start with rzp_test_... — payments made with these are simulated,
# no real money moves. Use Razorpay's published test card/UPI numbers to pay.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# ── Resend (Email) — use a test/sandbox sender so staging emails are obviously
#    not real production notifications ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=staging@nexcart-staging.vercel.app

# ── Cloudinary — can reuse prod account, but consider a separate "staging"
#    folder/preset so test uploads don't mix with real product images ─────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Shiprocket — use Shiprocket's test/sandbox credentials if available ───────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ── Upstash Redis — separate Redis DB (free tier) so staging rate-limit
#    counters don't affect production limits ──────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cron Security — generate a DIFFERENT secret from production ───────────────
CRON_SECRET=

# ── Razorpay Route (Seller Payouts) — leave unset in staging unless you're
#    specifically testing the payout flow with Razorpay's test payouts ───────
RAZORPAY_PAYOUT_KEY_ID=
RAZORPAY_PAYOUT_KEY_SECRET=
RAZORPAY_ROUTE_ACCOUNT_NUMBER=

PLATFORM_FEE_PERCENT=5
