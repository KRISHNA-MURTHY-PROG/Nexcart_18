# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://nexcart.vercel.app

# ── Database (Supabase + Prisma) ──────────────────────────────────────────────
# Standard connection string (via pgBouncer — used at runtime by Prisma)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (bypasses pgBouncer — required for prisma migrate / prisma db push)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Supabase Realtime (browser-side, public values) ───────────────────────────
# Optional — live cross-device sync for storefront pages (see
# src/hooks/useSellerRealtimeSync.ts). Leave blank to disable; the app works
# fine without it, devices just won't see each other's changes until refresh.
# Project Settings → Data API → "anon public" key in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Firebase (Client SDK) ─────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — without this, verifyFirebaseToken fails for every
# request and all authenticated API routes will return "Unauthorized".
# Option A (preferred): paste the full service account JSON as a single line
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com", ...}'

# Option B: individual fields (used as a fallback if the JSON above isn't set)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# ── Resend (Email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@nexcart.vercel.app

# ── Cloudinary (Image uploads) ────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Shiprocket (Shipping) ─────────────────────────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ── Upstash Redis (Rate limiting) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cron Security ─────────────────────────────────────────────────────────────
# Protects /api/cron/* routes. Vercel sends this as Authorization: Bearer <token>
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ── Razorpay Route (Seller Payouts) ───────────────────────────────────────────
# Activate first: Razorpay Dashboard → Payouts → Activate (takes 1-3 business days)
#
# Step 1 — Payout-specific API keys (DIFFERENT from regular payment keys above)
#   Generate: Razorpay Dashboard → Settings → API Keys → Payouts tab
RAZORPAY_PAYOUT_KEY_ID=
RAZORPAY_PAYOUT_KEY_SECRET=
#
# Step 2 — Your Razorpay nodal account number (shown in Razorpay Dashboard → Payouts)
#   This is the account you load money into before paying sellers.
RAZORPAY_ROUTE_ACCOUNT_NUMBER=

# Platform fee percentage deducted from each order before paying seller
# Set to 0 if your model is subscription-only (no commission)
PLATFORM_FEE_PERCENT=0
