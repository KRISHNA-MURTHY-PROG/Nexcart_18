# ── Catalog DB (SEPARATE Supabase project from main app) ──────────────────────
DATABASE_URL=postgresql://postgres.[catalog-project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[catalog-project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Main app DB (used ONLY by the sync script, never by the Next.js app) ──────
SOURCE_DATABASE_URL=postgresql://postgres.[main-project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── App URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CATALOG_URL=http://localhost:3001
NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3000

# Cloudinary (for next/image remote patterns, no secrets needed here)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Cron security ─────────────────────────────────────────────────────────────
# Vercel sends this as "Authorization: Bearer <secret>" when it fires the cron.
# Generate with: openssl rand -base64 32
CRON_SECRET=
