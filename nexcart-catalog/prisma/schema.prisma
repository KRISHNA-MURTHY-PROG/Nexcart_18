// ════════════════════════════════════════════════════════════════════════════
// CATALOG DB SCHEMA — subset of the main NexCart schema.
//
// This database is READ-MOSTLY: the Next.js app here only reads from it.
// All writes happen via the sync script (scripts/sync.ts), which copies rows
// from the main app's database on a schedule (cron). Do NOT write to this DB
// from user-facing requests in this app — orders, cart, wishlist, auth, etc.
// all stay in the main app.
//
// Relations to User/Order/Cart/etc are intentionally removed since those
// tables don't exist in this DB. User-identifying fields on Review/ProductQA
// are denormalized (plain strings) instead of relations.
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum ProductCondition {
  ORIGINAL
  REFURBISHED
  BOX_OPEN
}

model Category {
  id          String    @id
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  products Product[]

  @@index([isActive])
  @@index([sortOrder])
}

model Seller {
  id               String       @id
  sellerId         String       @unique
  storeName        String
  // Mirrored from the main app so catalog-served storefronts can resolve
  // vanity URLs (nexcart.com/<storeHandle>). Kept in sync by scripts/sync.ts.
  storeHandle      String?      @unique
  description      String?
  logo             String?
  banner           String?
  status           SellerStatus @default(PENDING)
  rating           Float        @default(0)
  totalRatings     Int          @default(0)
  totalReviews     Int          @default(0)
  totalOrders      Int          @default(0)
  isVerified       Boolean      @default(false)
  isLocalStore     Boolean      @default(false)
  storeAddress     String?
  pickupHours      String?
  pickupAcceptsCOD Boolean      @default(false)
  highlights       String[]     @default([])
  quickTags        String[]     @default([])
  storeColor       String?
  storePaused      Boolean      @default(false)
  storePausedMsg   String?
  galleryProductIds String[]    @default([])
  updatedAt        DateTime     @default(now())

  products    Product[]
  collections StoreCollection[]

  @@index([sellerId])
  @@index([status])
  @@index([status, rating])
}

model Product {
  id             String           @id
  productId      String           @unique
  sellerId       String
  seller         Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?        @relation(fields: [categoryId], references: [id])
  name           String
  description    String
  deliveryInfo   String?
  price          Float
  comparePrice   Float?
  stock          Int              @default(0)
  images         String[]
  tags           String[]
  isActive       Boolean          @default(true)
  isFeatured     Boolean          @default(false)
  isFlashSale    Boolean          @default(false)
  condition      ProductCondition @default(ORIGINAL)
  specifications Json?
  variantImages  Json?
  rating         Float            @default(0)
  reviewCount    Int              @default(0)
  salesCount     Int              @default(0)
  gstRate        Float?
  hsnCode        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now())

  variants ProductVariant[]
  reviews  Review[]
  qas      ProductQA[]

  @@index([productId])
  @@index([sellerId])
  @@index([categoryId])
  @@index([name])
  @@index([isActive])
  @@index([isActive, createdAt])
  @@index([isActive, isFeatured])
  @@index([isActive, salesCount])
  @@index([isActive, price])
}

model ProductVariant {
  id           String  @id
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  value        String
  stock        Int     @default(0)
  price        Float?
  comparePrice Float?

  @@index([productId])
}

// Denormalized — userName/userAvatar copied at sync time, no FK to User
// (the User table lives only in the main app's database).
model Review {
  id              String   @id
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userName        String
  userAvatar      String?
  rating          Int
  title           String?
  body            String?
  images          String[]
  helpfulCount    Int      @default(0)
  sellerReply     String?
  sellerRepliedAt DateTime?
  createdAt       DateTime @default(now())

  @@index([productId])
}

model ProductQA {
  id          String    @id
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userName    String
  question    String
  answer      String?
  answeredAt  DateTime?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([productId])
}

model StoreCollection {
  id         String   @id
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name       String
  image      String?
  filterTag  String
  productIds String   @default("[]")
  sortOrder  Int      @default(0)

  @@index([sellerId])
  @@index([sellerId, sortOrder])
}
